// EventControl database schema (SQLite via Prisma).
// DATABASE_URL defaults to prisma/eventcontrol.db (set by scripts/prisma.mjs and the server);
// hosted deployments point it at a persistent volume, e.g. file:/data/eventcontrol.db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A person who signs in. With Supabase sign-in, authId is the Supabase Auth user id; with the
/// single-password mode there is one "local" user. Events belong to exactly one user.
model User {
  id          String    @id @default(cuid())
  authId      String    @unique
  email       String    @unique
  name        String    @default("")
  // Console preferences that follow the person to any computer (theme, shortcuts, layout…).
  preferences String    @default("{}")
  // Subscription tier, for later: "free" today.
  plan        String    @default("free")
  // "active" can sign in. "pending": asked for access on the sign-in page, waiting for the
  // administrator's approval (their Supabase login stays locked until then).
  status      String    @default("active")
  // Proved they own the email (code sent to it when asking for access).
  emailVerified  Boolean   @default(false)
  requestedAt    DateTime?
  verifyCodeHash String?
  verifyExpires  DateTime?
  verifyAttempts Int       @default(0)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  events Event[]
}

model Event {
  id             String   @id @default(cuid())
  // Who owns (and alone can run) this event. Null only for events from before accounts.
  ownerId        String?
  name           String
  date           DateTime
  description    String   @default("")
  venue          String   @default("")
  waitingMessage String   @default("Please wait…")
  // Media shown by the "SHOW EVENT LOGO" emergency control (optional).
  logoMediaId    String?
  // Branding overlay: a logo drawn on top of the display output.
  overlayMediaId String?
  // top-left | top-right | bottom-left | bottom-right | center
  overlayPosition String  @default("top-right")
  // Width as a percentage of the screen width.
  overlaySize    Int      @default(12)
  // 0-100
  overlayOpacity Int      @default(90)
  overlayVisible Boolean  @default(false)
  // Operator preferences for this event as JSON: Quick Selection, default presentation…
  preferences    String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  media         Media[]
  queueItems    QueueItem[]
  scheduleItems ScheduleItem[]
  screens       Screen[]
  timerState    TimerState?
  displayState  DisplayState?
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

model Media {
  id           String   @id @default(cuid())
  eventId      String
  // Human-friendly, renamable name ("Welcome.pptx").
  name         String
  originalName String
  // Path relative to the uploads root. Never sent to clients.
  storagePath  String
  // image | video | pdf | presentation
  kind         String
  mimeType     String
  size         Int
  // sha256 of the file contents, used to avoid duplicate uploads.
  hash         String
  // Library folder, e.g. "Speakers", "Sponsors", "Logos". Empty = unfiled.
  folder       String   @default("")
  // Pages (PDF) or slides (converted PPT/PPTX). Null when unknown.
  pageCount    Int?
  // Browser-renderable PDF generated from a PPT/PPTX (relative storage path).
  renderPath   String?
  // none | pending | ready | failed | unavailable
  conversionStatus String @default("none")
  conversionError  String?
  // Where the file came from: "upload" or "drive" (sourceRef = Google Drive file id).
  source           String   @default("upload")
  sourceRef        String?
  // local | pending | synced | error  (cloud storage copy)
  cloudStatus  String   @default("local")
  cloudError   String?
  createdAt    DateTime @default(now())

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  queueItems QueueItem[]

  @@unique([eventId, hash])
  @@index([eventId])
}

model QueueItem {
  id              String   @id @default(cuid())
  eventId         String
  // media | screen
  kind            String   @default("media")
  mediaId         String?
  screenId        String?
  // Optional page/slide range for PDF and converted presentations (1-based, inclusive).
  startPage       Int?
  endPage         Int?
  position        Int
  // Optional label, e.g. "Director Speech". Falls back to the media name.
  title           String?
  durationSeconds Int?
  // Operator-only speaker notes. Never sent to display clients.
  notes           String   @default("")
  // Longer presenter script for this item (script layout). Operator-only, like notes.
  script          String   @default("")
  createdAt       DateTime @default(now())

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media  Media?  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  screen Screen? @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
}

/// A full-screen message: "Please Wait", "Technical Difficulty", custom announcements...
model Screen {
  id                 String   @id @default(cuid())
  eventId            String
  // Built-in screens have a stable key (please-wait, technical, break, starting, coming-up, thanks).
  key                String?
  title              String
  subtitle           String   @default("")
  // Visual style / accent: please-wait | technical | break | starting | coming-up | thanks | custom
  style              String   @default("custom")
  backgroundMediaId  String?
  showTimer          Boolean  @default(false)
  position           Int      @default(0)
  createdAt          DateTime @default(now())

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  queueItems QueueItem[]

  @@unique([eventId, key])
  @@index([eventId])
}

/// Key/value application settings (e.g. operator password hash, session secret).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ScheduleItem {
  id              String   @id @default(cuid())
  eventId         String
  // Local wall-clock time "HH:MM".
  time            String
  title           String
  description     String   @default("")
  durationMinutes Int?
  createdAt       DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, time])
}

model TimerState {
  eventId       String    @id
  durationMs    Int       @default(600000)
  warningMs     Int       @default(120000)
  // idle | running | paused | finished
  status        String    @default("idle")
  // Remaining time at the moment `startedAt` was recorded (or now, if not running).
  remainingMs   Int       @default(600000)
  startedAt     DateTime?
  // When the countdown reached zero (null unless finished).
  finishedAt    DateTime?
  showOnDisplay Boolean   @default(false)
  updatedAt     DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model DisplayState {
  eventId      String   @id
  // media | screen | black | logo
  mode         String   @default("screen")
  // Special screen shown in "screen" mode (null = the Please Wait screen).
  screenId     String?
  // The queue cursor ("current item").
  queueItemId  String?
  // Media shown directly from the library, overriding the queue cursor.
  adHocMediaId String?
  // 1-based page for PDF content, controlled by the operator.
  page         Int      @default(1)
  updatedAt    DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}
